# ============================================
# Configuración de la aplicación
# ============================================

# Clave secreta de Flask (cambiar en producción)
SECRET_KEY=cambiar-esta-clave-en-produccion-2026

# Puerto de la aplicación
PORT=5000

# ============================================
# Fuente de datos del Excel
# ============================================
# EXCEL_SOURCE puede ser:
#   auto     - Intenta OneDrive primero, fallback a archivo local (default)
#   onedrive - Solo OneDrive (error si no disponible)
#   local    - Solo archivo local
EXCEL_SOURCE=auto

# ============================================
# Microsoft Graph API (OneDrive)
# ============================================
# Obtener estos valores desde Azure Portal > App Registrations
# Ver guía: docs/SETUP_ONEDRIVE.md

# Tenant ID (Directory tenant ID)
MS_TENANT_ID=

# Client ID (Application client ID)
MS_CLIENT_ID=

# Client Secret (crear en Certificates & secrets)
MS_CLIENT_SECRET=

# Email del usuario de OneDrive donde está el Excel
# (ej: tuemail@tudominio.onmicrosoft.com)
MS_DRIVE_USER=

# Ruta del archivo Excel en OneDrive
# (ej: Documentos/Respuestas de formulario.xlsx)
MS_EXCEL_PATH=Documentos/Respuestas de formulario.xlsx
